# Tumar.AI configuration — copy to .env (or set these in your shell)
# and fill in the values you need. NEVER commit the filled-in copy:
# .env is gitignored, .env.example is not.
#
# Everything here is optional except the AI key for whichever provider
# you actually use. Missing values disable a feature; they never break
# the app — the Trust Engine's deterministic layer works regardless.


# --- AI providers -----------------------------------------------------
#
# The platform's measured default. The Streamlit app can also read this
# from .streamlit/secrets.toml.
GEMINI_API_KEY=

# DeepSeek V4 Flash, over its OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://model.inferx.net/endpoints/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Set to 1 only once you have confirmed this model reads images. It
# defaults to off: claiming an unverified capability would route
# screenshots to it and fail in front of a user.
DEEPSEEK_VISION=0

# Which provider answers text analysis. Deliberately empty by default —
# a key appearing in the environment is not a decision to change what
# every scam verdict is based on. Set it, then run the evaluation
# harness (`python evals/runner.py --ai`) and compare before trusting
# the switch.
#   TUMAR_TEXT_PROVIDER=deepseek
TUMAR_TEXT_PROVIDER=

# Which provider reads screenshots. Empty means "whichever is
# configured and declares vision support"; none means image analysis is
# simply unavailable.
TUMAR_VISION_PROVIDER=

# Other providers, present as supported shapes but untested here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5


# --- REST API ---------------------------------------------------------

# Keys allowed to call the API. Empty means every analysis request is
# refused — the service fails closed rather than serving openly.
# Real customers get issued keys instead: python -m api.keys issue
TUMAR_API_KEYS=

# Where issued keys, usage records and contributed samples live.
TUMAR_DB_PATH=tumar.db

TUMAR_RATE_LIMIT=60
TUMAR_RATE_WINDOW=60
TUMAR_MAX_CONTENT=5000

# Browser origins allowed to call the API. Empty is correct for a
# server-to-server API.
TUMAR_ALLOWED_ORIGINS=

TUMAR_LOG_LEVEL=INFO


# --- Contributed samples (app) ----------------------------------------
#
# The app will not offer to collect samples unless it knows they will
# survive. Either point it at an API that owns the database…
TUMAR_API_URL=
TUMAR_APP_API_KEY=

# …or, if this host's disk persists across restarts, say so.
TUMAR_DURABLE_STORAGE=0
