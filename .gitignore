# Python
__pycache__/
*.pyc

# Virtual environment
venv/
.venv/

# Secrets — never commit API keys. Matched anywhere in the tree, so a
# copied folder ("X - Copy", "X (1)") cannot carry them in by accident.
.env
.env.*
!.env.example
secrets.toml
*.pem
*.key
**/.streamlit/secrets.toml

# Explorer/OneDrive folder copies are stale snapshots, sometimes with
# old credentials inside. Never track them.
* - Copy/
* - Copy (*)/
* (1)/
* (2)/

# Untracked duplicate of app/news (the bot imports app/news).
telegram_bot/app/

# Evaluation runs — one machine at one moment. The corpus is what
# belongs in history, not the output of a particular run.
evals/results/

# Image-scanner evaluation set: real screenshots carry other people's
# data and stay local. Runs are one machine at one moment.
evals/image_scanner/images/
evals/image_scanner/results/

# Key and usage database. Keys are stored hashed, but this file still
# holds customer identities and their traffic, and it has no business
# in version control.
*.db
*.db-journal

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local build output (deck builds, node_modules). Never commit.
tmp/
