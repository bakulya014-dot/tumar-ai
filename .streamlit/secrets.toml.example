# Copy the [auth] block below into .streamlit/secrets.toml (local) or
# the Secrets box of your Streamlit Cloud app. Never commit real values:
# this file IS committed, so it must only ever hold placeholders.
#
# Google OAuth client: https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorized redirect URIs:
#     http://localhost:8501/oauth2callback                 (local)
#     https://tumar-ai.streamlit.app/oauth2callback        (production)
#   OAuth consent screen -> publish to "In production" so anyone with a
#   Google account can register (in "Testing" only listed testers can).

[auth]
# Production: "https://tumar-ai.streamlit.app/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Also accepted (auth.py detects either): the three client keys placed
# directly under [auth] instead of in [auth.google]. Use one layout,
# not both; if both are present, [auth.google] is used.
